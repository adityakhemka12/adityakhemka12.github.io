@article{khemka,
  title={Collateral Damage? The Nationalization of Housing Risk},
  author={Khemka, Aditya},
  year={2026},
  preview={housingbeta.jpg},
  abstract={I study how housing’s nationalization affects household welfare. I document that local US house prices have become more sensitive to the national cycle since the 1990s, increasing the share of homeowners in substantially exposed markets from 60\% to 85\%. I find that exposure operates predominantly through price–rent valuations and is associated with aligned expectations and mortgage financing. Greater exposure accompanies more refinancing and higher borrowing relative to income, rather than credit withdrawal. Lower-income borrowers stretch further against income, while first-time buyers face larger delinquency disadvantages in more exposed markets. I document distinct exposure across wealth groups: poorer households face borrowing constraints, middle-wealth households hold concentrated housing positions, and wealthier households more often move between owned homes. I develop a quantitative spatial life cycle model to quantify competing effects through diversification, mortgage access and replacement-housing insurance. I measure welfare gains and losses across households and locations, and evaluate refinancing policies and borrowing limits.},
  presentations={CEPR Paris Symposium 2026 (Poster), LSE Macro PhD Workshop 2026, Simposio de la Asociación Española de Economía (SAEe) 2026, 2026 Lugano Real Estate and Urban Economics Conference (Poster), 28th Macro Finance Society Workshop INSEAD (Poster)}, 
  category={working_paper},
  display_order={01},
  job_market_paper={true}
}

@article{hylandkhemka,
  title={The Inequality Multiplier: Portfolio Allocation Frictions and Wealth Inequality},
  author={Hyland, C. Chris and Khemka, Aditya},
  year = {2026},
  abstract={How do frictions in financial intermediation shape wealth inequality? We study portfolio allocation frictions that limit intermediaries' substitution between equity and debt, while household saving and borrowing adjust endogenously. In a model with heterogeneous households, a penalty for departing from a target equity share links equity revaluation to expanding debt, increasing the wealth concentration generated by asset demand. Calibrated to the U.S. economy, the model better accounts jointly for rising wealth concentration, expanding household borrowing and falling interest rates than a flexible benchmark. Wealthy income and dividend growth sustain saving that finances additional borrowing, while portfolio restrictions reinforce concentration. The inequality multiplier measures the top wealth share's conditional sensitivity to equity appreciation and is almost twice as large under portfolio allocation frictions. Even with identical equity price paths, portfolio allocation frictions produce a cumulative top wealth share response about one third larger through additional lending.},
  preview={inequalitymultiplier.jpg},
  website={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5310388},
  presentations={EEA-ESEM 2026 Dublin (August 2026), ISB Summer Research Conference (July 2026), AFA Annual Meeting Poster Session (January 2026), Bank of England Macro Brown Bag (July 2025); Asian Finance Association, Taipei (June 2025); Trans-Atlantic Doctoral Conference, London Business School (June 2025); Rethinking Economic Theory Conference, Athens (December 2024)},
  selected={true},
  award={Saïd Foundation Award for Best Doctoral Paper in Finance, 2025},
  category={working_paper},
  display_order={02},
  status={Submitted},
}

@article{khemkatsomocos,
  title={Green Policy, Unequal Outcomes},
  author={Khemka, Aditya and Tsomocos, Dimitrios P.},
  year = {2025},
  abstract={We investigate how climate-focused financial regulations impact wealth inequality and economic welfare. Who loses on the climate transition path and/or due to environment policy? Which trade-offs should policy makers address? We develop a two-period general equilibrium model with heterogeneous households, incomplete markets, and endogenous climate damages to assess the effects of green capital requirements and carbon taxes. Our findings reveal that while green capital regulations reduce pollution, they also constrain credit allocation, lowering aggregate efficiency and amplifying wealth inequality through labor market distortions. We identify a fundamental trade-off: policies that effectively mitigate environmental harm tend to increase inequality, while those that reduce inequality often fall short in addressing climate risks. We show that carbon taxes outperform green capital regulations in reducing emissions and cause a smaller rise in inequality. Empirical evidence supports these findings, particularly in developed economies where credit contraction exacerbates distributional disparities. Our results highlight the need for policymakers to balance environmental goals with equity considerations in designing climate policy.},
  preview={climateinequality.jpg},
  website={https://ssrn.com/abstract=6303041},
  presentations={Bank of England Financial Stability Seminars (September 2025), Bank of England PPD Research Discussion Group (May 2025); Oxford Saïd - VU SBE Macro-finance Conference, Oxford (June 2024); IV Central Bank Conference on Environmental Risks, Mexico City (December 2023)},
  selected={true},
  category={working_paper},
  display_order={03},
  status={Submitted},
}

@article{khemkakarmakarrolandkhairnar,
  title={From Theory to Toolkit: Informing CCyB Decisions with a Quantitative Framework},
  author={Khemka, Aditya and Karmakar, Sudipto and Michalski-Roland, Isabelle and Khairnar, Kunal},
  year = {2026},
  abstract={We develop a framework for setting the countercyclical capital buffer and apply it to UK history and Bank of England stress scenarios. We make three contributions. First, we propose an asymmetric macroprudential loss function whose crisis penalties on output, credit and bank default are disciplined by historical evidence. Second, we derive the optimal buffer policy implied by this loss in an estimated nonlinear macro-banking model with mortgage, corporate and bank default. Optimal policy acts as insurance against bank failure, building the buffer ahead of bank stress and releasing it into downturns. Third, we show that the policymaker's loss and household welfare can diverge. Over UK history, the optimal buffer largely eliminates the bank-default spike of 2008 but leaves welfare essentially unchanged, because borrowers bear the cost. In severe stress scenarios, the loss and welfare align, and gains are sizeable, driven by bank-risk shocks. A simple rule captures most of these gains. The framework turns any stress scenario into an optimal buffer path and offers a welfare benchmark for evaluating actual policy.},
  preview={ccybboe.jpg},
  selected={true},
  category={working_paper},
  display_order={04},
  note={Bank of England},
}

@article{khemkalaskaridistsomocos,
  title={Climate change, macroprudential policy responses and
their distributional consequences in South Africa},
  author={Khemka, Aditya and Laskaridis, Christina and Tsomocos, Dimitrios P.},
  year = {2025},
  abstract={In transitioning from coal-dependent growth to a low-carbon economy, South Africa faces
intertwined environmental, macro-financial and distributional risks. We build a two-period
computable general equilibrium model with heterogeneous households, firms and a dual-
tier banking system, embedding endogenous default, brown and green capital markets and
a pollution-damage feedback. After calibrating to South African data, we compare three
instruments – downstream carbon taxes, brown risk-weighted capital surcharges and
green capital discounts – individually and jointly. Carbon taxation most sharply curbs
emissions and, when revenues are rebated to workers, also narrows wealth and
consumption inequality. Brown penalising factors restrain leverage and reduce default
probabilities but raise energy prices and widen wage inequality; green supporting factors
lower financing costs yet trigger a Jevons-type rebound that can increase coal demand.
Welfare decompositions show that no single tool dominates; the optimal approach involves
pairing a carbon tax with prudential tweaks that balance climate gains, stability and equity
for South Africa.},
preview={CapitalCrowdOut.jpg},
journal={South African Reserve Bank Working Paper Series},
website={https://www.resbank.co.za/content/dam/sarb/publications/working-papers/2025/climate-change,-macroprudential-policy-responses-and-their-distributional-consequences-in-south-africa.pdf},
selected={true},
presentations={Committee of Central Bank Governors in SADC (CCBG) Climate Change Policy Dialogue, Lusaka (July 2025)},
category={working_paper},
display_order={05},
}


@article{khemkafeyertag,
  title={AI and Climate Risks to India’s labour market},
  author={Khemka, Aditya and Feyertag, Joe},
  year = {2026},
  abstract = {We estimate India’s joint labour market exposure to AI and climate risks, with a focus on low-end services and other routine task, informal occupations, at industry and state level. We combine AI exposure measures with green transition susceptibility measures, including industry emissions intensity, to build a state-level picture of jobs at risk from the twin transitions. A simple general equilibrium model then asks whether the two transitions compound, offset or substitute for each other, and whether green sectors can act as a shock absorber for AI-related job losses. We compare policy options and their trade-offs and offer policy recommendations to deal with the twin transitions.},
  selected={true},
  category={work_in_progress},
  display_order={06},
  preview={cetex.jpg},
  note={Centre for Economic Transition (CETEx), LSE},
}
